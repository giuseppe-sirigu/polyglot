{
  "name": "@usepolyglot/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for Polyglot. Not published - see packages/cli.",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prepublishOnly": "echo 'The workspace root is not publishable. Run: pnpm publish:manual' && exit 1",
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @usepolyglot/cli run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "scenario:live": "tsx scripts/scenario-matrix.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "publish:manual": "pnpm build && d=$(mktemp -d) && pnpm --filter @usepolyglot/cli pack --pack-destination \"$d\" && npm publish \"$d\"/usepolyglot-cli-*.tgz --access public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "qs@<6.16.0": ">=6.16.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "openai>zod": "4"
      }
    }
  }
}
