{
  "name": "polyglot",
  "version": "0.1.0",
  "private": true,
  "description": "A model-agnostic coding-agent CLI that works reliably with frontier and open-weight models alike.",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @usepolyglot/cli run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
