{
  "name": "@usepolyglot/cli",
  "version": "0.3.0",
  "private": false,
  "description": "A coding-agent CLI that works the same way whether the model is Claude, GPT, or an open-weight model like Qwen, DeepSeek, GLM, or Llama running locally.",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://usepolyglot.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giuseppe-sirigu/polyglot.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/giuseppe-sirigu/polyglot/issues",
  "author": "Giuseppe Sirigu",
  "keywords": ["ai", "agent", "llm", "coding-agent", "cli", "mcp", "ollama", "local-llm"],
  "type": "module",
  "bin": {
    "polyglot": "./dist/main.js"
  },
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "prepack": "node ../../scripts/gen-cli-readme.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "ajv": "^8.17.1",
    "chalk": "^5.3.0",
    "diff": "^9.0.0",
    "glob": "^11.0.0",
    "ink": "^7.1.1",
    "jsonrepair": "^3.11.2",
    "minimatch": "^10.0.1",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/react": "^19.2.18",
    "@usepolyglot/core": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
